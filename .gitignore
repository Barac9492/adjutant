# The single most important line in this file.
# os.config.yaml holds real secrets (bot tokens, chat ids) once the wizard
# runs. It must never reach git history. If you're not sure this line is
# working, run: git check-ignore -v config/os.config.yaml
config/os.config.yaml

# Local state generated by the OS at runtime — not source, don't track it.
tasks/scout-*.md
tasks/plan-*.md
tasks/progress-*.md
tasks/review-*.md
tasks/lessons.md

# OS-level cruft
.DS_Store
*.log
node_modules/
